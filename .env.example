# StopCode wellness chat configuration.
# Copy this file to .env (next to package.json). The dashboard server is the only process
# that reads it; the key never reaches the browser, the logs or the state files.
# .env is git-ignored. Never commit a real key.
#
# A Claude Code subscription does NOT provide API credentials. Create an API key in the
# Anthropic Console and paste it below. Without a key the dashboard still works; only the
# wellness chat shows its configuration-required state.
ANTHROPIC_API_KEY=

# Model used by the wellness chat. Default shown; any current Claude model id works.
STOPCODE_CHAT_MODEL=claude-opus-5-5
